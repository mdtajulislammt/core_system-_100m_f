# ==============================================================================
# OmniStream 100M - Environment Configuration Template
# Copy this file to .env.local for local overrides: `cp .env.example .env.local`
# ==============================================================================

# API Base URL for records endpoint
# Defaults to Next.js App Router internal endpoint: /api/records
# Point to external NestJS/Express/FastAPI backend if running separately:
# e.g., http://localhost:5000/api/records
NEXT_PUBLIC_API_URL="/api/records"

# Default cursor pagination batch limit (recommended: 25, 50, 100, 200)
NEXT_PUBLIC_DEFAULT_PAGE_SIZE=50

# Maximum pages kept in active TanStack Query memory before trimming
# Prevents browser JavaScript heap exhaustion on deep scrolls through 100M items
NEXT_PUBLIC_MAX_PAGES_IN_MEMORY=30

# Search input debounce latency in milliseconds (prevents Elasticsearch spam)
NEXT_PUBLIC_SEARCH_DEBOUNCE_MS=350

# Total estimated dataset scope for UI telemetry and percentage indicators
NEXT_PUBLIC_TOTAL_RECORDS_ESTIMATE=100000000

# Optional server-side external backend proxy target
# Used by Next.js route handlers if proxying to a remote microservice
BACKEND_PROXY_URL=""
