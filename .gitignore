# ==============================================================================
# OmniStream 100M - Production .gitignore
# ==============================================================================

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js & Turbopack build outputs
/.next/
/out/
/build/
/.turbo/

# Environment Variables (Keep secrets local; commit only .env.example)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local
!.env.example

# Testing & Coverage
/coverage
*.lcov
.nyc_output

# Logs & Debugging
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# Vercel Deployment
.vercel

# TypeScript & Bundler Cache
*.tsbuildinfo
next-env.d.ts

# IDE & Code Editors
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.sublime-workspace
*.sublime-project

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
